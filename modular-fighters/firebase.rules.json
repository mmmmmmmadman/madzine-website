{
  "rules": {
    "mf": {
      "queue": {
        ".read": true,
        "$qid": {
          ".write": true,
          ".validate": "newData.hasChildren(['name', 'char', 'room', 't']) && newData.child('name').isString() && newData.child('name').val().length <= 12 && newData.child('room').isString() && newData.child('room').val().length == 4"
        }
      },
      "matches": {
        ".read": true,
        "$mid": {
          ".write": true
        }
      },
      "leaderboard": {
        ".read": true,
        ".indexOn": [
          "wins"
        ],
        "$key": {
          ".write": true,
          ".validate": "newData.hasChildren(['name', 'wins', 'losses']) && newData.child('name').isString() && newData.child('name').val().length <= 12 && newData.child('wins').isNumber() && newData.child('losses').isNumber()"
        }
      },
      "submissions": {
        ".read": true,
        ".indexOn": [
          "t"
        ],
        "$sid": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['kind', 'name', 't']) && newData.child('kind').isString() && (newData.child('kind').val() == 'invite' || newData.child('kind').val() == 'new') && newData.child('name').isString() && newData.child('name').val().length <= 12 && newData.child('t').isNumber()",
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "contact": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "module": {
            "desc": {
              ".validate": "newData.isString() && newData.val().length <= 1500"
            },
            "sketch": {
              ".validate": "newData.isString() && newData.val().length <= 420000"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            }
          }
        }
      }
    }
  }
}
